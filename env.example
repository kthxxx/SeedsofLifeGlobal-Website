# Public canonical URL, used for metadata and form-origin validation.
NEXT_PUBLIC_SITE_URL=https://www.seedsoflifeglobal.org

# Optional additional exact HTTPS origins (comma-separated), e.g. the bare domain
# if it serves pages instead of redirecting to the canonical www domain.
CONTACT_ALLOWED_ORIGINS=

# Shared contact rate limiting for Vercel. Use an Upstash Redis database's REST
# URL and STANDARD read/write token, not its read-only token. Server-only secrets.
# Without both settings (or during an outage), production submissions return 503.
# Local `next dev` uses a small bounded in-memory bucket and needs neither value.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend contact-form configuration. Keep these values in .env.local or your
# deployment provider's encrypted environment settings; never commit secrets.
RESEND_API_KEY=re_your_resend_api_key
CONTACT_FROM_EMAIL=Seeds of Life Global <contact@your-verified-domain.org>
CONTACT_TO_EMAIL=seedsoflifeglobal@gmail.com
